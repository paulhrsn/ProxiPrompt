# Copy values you actually have. Never commit secrets.

# SpacetimeDB
VITE_SPACETIMEDB_URI=ws://127.0.0.1:3000
VITE_SPACETIMEDB_DB=proxiprompt
SPACETIMEDB_URI=ws://127.0.0.1:3000
SPACETIMEDB_DB=proxiprompt
SPACETIMEDB_TOKEN=

# SpacetimeAuth magic link. Register both redirect URIs:
#   http://localhost:5173/callback
#   http://127.0.0.1:5173/callback
# Without a client id, the app starts in Dev (anonymous browser session).
VITE_SPACETIMEAUTH_CLIENT_ID=

# Google Places (optional; curated catalog works without it)
VITE_GOOGLE_MAPS_API_KEY=

# Web Push (npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@proxiprompt.local

# Agent
AGENT_URL=http://127.0.0.1:8001
ASI_ONE_API_KEY=
ASI_ONE_MODEL=asi1-mini
AGENT_SEED=
AGENT_MAILBOX=
AGENTVERSE_API_KEY=
ORCHESTRATOR_URL=http://127.0.0.1:8080

# Orchestrator
ORCH_PORT=8080
DEMO_MODE=1
ENABLE_BLUESKY=1
